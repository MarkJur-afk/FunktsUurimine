<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FunktsiooniUurimine</title>

    <link rel="stylesheet" href="~/css/site.css" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

    <header class="topbar">
        <nav>
            <a asp-controller="Home" asp-action="Index">Avaleht</a>

            <a asp-controller="Funktsioonid" asp-action="Index">
                Funktsioonid
            </a>

            <a asp-controller="Funktsioonid" asp-action="Create">
                Uus analüüs
            </a>

            <button id="themeToggle" class="theme-toggle">
                🌙 Tume teema
            </button>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="~/java/theme.js"></script>

</body>
</html>