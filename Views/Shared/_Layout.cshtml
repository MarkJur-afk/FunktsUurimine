<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FunktsiooniUurimine</title>

    <link rel="stylesheet" href="~/css/site.css" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

    <header class="topbar">
        <nav>
            <a class="brand" asp-controller="Home" asp-action="Index">Funktsioonid</a>

            <a asp-controller="Funktsioonid" asp-action="Index" data-i18n="nav.saved">Minu analüüsid</a>

            <a asp-controller="Funktsioonid" asp-action="Create" data-i18n="nav.new">Uus analüüs</a>

            <a asp-controller="Home" asp-action="Theory" data-i18n="nav.theory">Teooria</a>

            <select id="languageSelect" class="language-select" aria-label="Keel / Язык">
                <option value="et">EST</option>
                <option value="ru">RUS</option>
            </select>

            <button id="themeToggle" class="theme-toggle">
                🌙 Tume teema
            </button>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="~/java/theme.js"></script>
    <script src="~/java/language.js"></script>

</body>
</html>
