@model FunktsiooniUurimine
@{ ViewData["Title"] = "Muuda"; }
<h1>Muuda funktsiooni</h1>
<form asp-action="Edit" method="post" class="form-card">
    <input type="hidden" asp-for="Id" />
    <label asp-for="Valem"></label>
    <input asp-for="Valem" />
    <span asp-validation-for="Valem" class="error"></span>
    <button class="button" type="submit">Salvesta</button>
    <a asp-action="Index">Tagasi</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
