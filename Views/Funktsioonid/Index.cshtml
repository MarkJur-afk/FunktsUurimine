@model IEnumerable<FunktsiooniUurimine>
@{ ViewData["Title"] = "Funktsioonid"; }
<div class="page-head"><h1>Funktsioonid</h1><a class="button" asp-action="Create">+ Lisa uus</a></div>
@if (!Model.Any()) { <p>Salvestatud funktsioone veel ei ole.</p> }
else {
<table>
<thead><tr><th>Valem</th><th>Tuletis</th><th>Nullkohad</th><th>Ekstreemumid</th><th></th></tr></thead>
<tbody>
@foreach (var item in Model) {
<tr><td>@item.Valem</td><td>@item.Tuletis</td><td>@item.Nullkohad</td><td>@item.Ekstreemumid</td><td class="actions"><a asp-action="Details" asp-route-id="@item.Id">Vaata</a><a asp-action="Edit" asp-route-id="@item.Id">Muuda</a><a asp-action="Delete" asp-route-id="@item.Id">Kustuta</a></td></tr>
}
</tbody></table>
}
